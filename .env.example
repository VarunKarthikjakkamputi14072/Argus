DATABASE_URL=postgresql+asyncpg://pipeline_user:pipeline_pass@localhost:5432/article_pipeline
SYNC_DATABASE_URL=postgresql://pipeline_user:pipeline_pass@localhost:5432/article_pipeline
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
LLM_API_KEY=your-api-key-here
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# APIForge integration (optional)
# Run APIForge locally or on Railway, then point Argus at it.
# With this set, POST /articles/seed-topic?topic=X pulls news articles
# from APIForge's cached NewsAPI feed and queues them for scraping.
APIFORGE_BASE_URL=http://localhost:8000
APIFORGE_API_KEY=af_your_key_here
